@model EventBrowseViewModel
@{ ViewData["Title"] = "Upcoming events"; }

@section Hero {
<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <p class="eyebrow mb-2"><i class="bi bi-lightning-charge-fill"></i> @(CurrentUser.IsParticipant ? $"Hey {CurrentUser.FullName?.Split(' ')[0]}," : "South Africa's race calendar")</p>
                <h1 class="mb-3">Find your next<br /><span class="accent">start line.</span></h1>
                <p class="lead mb-0">Road runs, fun walks and cycle tours — pick your distance, enrol in seconds and chase a new PB.</p>
            </div>
            @if (!CurrentUser.IsAuthenticated)
            {
                <div class="col-lg-4 mt-4 mt-lg-0 text-lg-end">
                    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Join RaceDay</a>
                    <a class="btn btn-outline-light btn-lg ms-2" asp-controller="Account" asp-action="Login">Log in</a>
                </div>
            }
        </div>
    </div>
</section>
}

<div class="container position-relative" style="z-index: 2;">
    <form method="get" asp-action="Index" class="rd-card filter-bar mb-4" role="search" aria-label="Filter events">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg">
                <label for="Search" class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input id="Search" name="Search" value="@Model.Search" class="form-control" placeholder="Event, venue or city" />
                </div>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label for="Type" class="form-label">Type</label>
                <select id="Type" name="Type" class="form-select">
                    <option value="">All types</option>
                    @foreach (var t in EventTypes.All)
                    {
                        <option value="@t" selected="@(Model.Type == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label for="Province" class="form-label">Province</label>
                <select id="Province" name="Province" class="form-select">
                    <option value="">All provinces</option>
                    @foreach (var p in Model.Provinces)
                    {
                        <option value="@p" selected="@(Model.Province == p)">@p</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label for="From" class="form-label">From</label>
                <input id="From" name="From" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label for="To" class="form-label">To</label>
                <input id="To" name="To" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-12 col-lg-auto d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-grow-1"><i class="bi bi-funnel"></i> Filter</button>
                @if (Model.HasFilters)
                {
                    <a asp-action="Index" class="btn btn-light" title="Clear filters" aria-label="Clear filters"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 class="mb-0">@(Model.HasFilters ? "Matching events" : "Upcoming events")</h2>
        <span class="text-muted">@Model.Events.Count event@(Model.Events.Count == 1 ? "" : "s")</span>
    </div>

    @if (ViewData["LoadError"] is string loadError)
    {
        <div class="alert flash flash-error"><i class="bi bi-x-octagon-fill"></i> @loadError</div>
    }

    @if (Model.Events.Count == 0)
    {
        <div class="rd-card empty-state">
            <i class="bi bi-calendar-x icon" aria-hidden="true"></i>
            <h3>No events found</h3>
            <p>@(Model.HasFilters ? "Try widening your search or clearing the filters." : "New events are added all the time — check back soon.")</p>
            @if (Model.HasFilters)
            {
                <a asp-action="Index" class="btn btn-primary">Clear filters</a>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var e in Model.Events)
            {
                <div class="col-sm-6 col-lg-4">
                    <partial name="_EventCard" model="(e, Model.EnrolledEventIds.Contains(e.EventId))" />
                </div>
            }
        </div>
    }
</div>
