@model DashboardViewModel
@{ ViewData["Title"] = "Organiser dashboard"; var next = Model.NextEvent; }

@section Hero {
<section class="page-band">
    <div class="container d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <p class="eyebrow mb-1">Organiser HQ</p>
            <h1>Dashboard</h1>
            <p class="mb-0 mt-2">Welcome back, @CurrentUser.FullName?.Split(' ')[0]. Here's how your events are tracking.</p>
        </div>
        <a class="btn btn-primary btn-lg" asp-action="CreateEvent"><i class="bi bi-plus-lg"></i> New event</a>
    </div>
</section>
}

<div class="container">
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3"><div class="stat-tile"><div class="icon icon--ink"><i class="bi bi-calendar3"></i></div><div><div class="value">@Model.Events.Count</div><div class="label">Events created</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="stat-tile"><div class="icon"><i class="bi bi-people-fill"></i></div><div><div class="value">@Model.TotalEnrolments.ToString("N0")</div><div class="label">Confirmed enrolments</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="stat-tile"><div class="icon icon--volt"><i class="bi bi-hourglass-split"></i></div><div><div class="value">@Model.Upcoming.Count</div><div class="label">Upcoming events</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="stat-tile"><div class="icon icon--info"><i class="bi bi-flag-fill"></i></div>
            <div>
                <div class="value" style="font-size:1.35rem;">@(next is null ? "—" : next.EventDate.ToString("d MMM yyyy"))</div>
                <div class="label">@(next is null ? "No upcoming events" : $"Next: {next.Title}")</div>
            </div></div></div>
    </div>

    @if (Model.Events.Count == 0)
    {
        <div class="rd-card empty-state">
            <i class="bi bi-megaphone icon" aria-hidden="true"></i>
            <h3>Create your first event</h3>
            <p>Set the date, venue and distances — athletes can enrol as soon as it's published.</p>
            <a class="btn btn-primary" asp-action="CreateEvent"><i class="bi bi-plus-lg"></i> New event</a>
        </div>
    }
    else
    {
        foreach (var (title, list) in new[] { ("Upcoming events", Model.Upcoming), ("Past events", Model.Past) })
        {
            if (list.Count == 0) continue;
            <section class="rd-card mb-4">
                <div class="rd-card-header"><h2>@title</h2><span class="text-muted small">@list.Count</span></div>
                <div class="table-responsive">
                    <table class="table rd-table">
                        <thead>
                            <tr><th>Event</th><th>Date</th><th>Type</th><th>Categories</th><th>Enrolments</th><th>Results</th><th class="text-end">Manage</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in list)
                            {
                                var pct = e.TotalCapacity == 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * e.ConfirmedEnrolments / e.TotalCapacity));
                                <tr>
                                    <td class="title-cell">
                                        <a asp-action="EditEvent" asp-route-id="@e.EventId">@e.Title</a>
                                        <div class="small text-muted fw-normal"><i class="bi bi-geo-alt"></i> @e.VenueName, @e.City</div>
                                    </td>
                                    <td class="text-nowrap">@e.EventDate.ToString("d MMM yyyy")</td>
                                    <td><partial name="_TypeChip" model="e.EventType" /></td>
                                    <td>
                                        @if (e.CategoryCount == 0)
                                        {
                                            <a asp-action="Categories" asp-route-id="@e.EventId" class="badge-status badge-status--warning text-decoration-none"><i class="bi bi-exclamation-triangle"></i>Add categories</a>
                                        }
                                        else { @e.CategoryCount }
                                    </td>
                                    <td style="min-width: 150px;">
                                        <a asp-action="Enrolments" asp-route-id="@e.EventId" class="fw-semibold text-decoration-none">@e.ConfirmedEnrolments.ToString("N0")</a>
                                        <span class="text-muted small">/ @e.TotalCapacity.ToString("N0")</span>
                                        <div class="capacity mt-1" title="@pct% full"><span style="width:@pct%"></span></div>
                                    </td>
                                    <td>
                                        @if (e.ResultsCaptured > 0)
                                        {
                                            <partial name="_StatusBadge" model="@("Published")" />
                                        }
                                        else if (title == "Past events" && e.ConfirmedEnrolments > 0)
                                        {
                                            <partial name="_StatusBadge" model="@("Awaiting result")" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-light" asp-action="EditEvent" asp-route-id="@e.EventId" title="Edit details"><i class="bi bi-pencil"></i><span class="visually-hidden">Edit @e.Title</span></a>
                                            <a class="btn btn-light" asp-action="Categories" asp-route-id="@e.EventId" title="Categories"><i class="bi bi-signpost-split"></i><span class="visually-hidden">Categories</span></a>
                                            <a class="btn btn-light" asp-action="Enrolments" asp-route-id="@e.EventId" title="Enrolments"><i class="bi bi-people"></i><span class="visually-hidden">Enrolments</span></a>
                                            <a class="btn btn-light" asp-action="Results" asp-route-id="@e.EventId" title="Results"><i class="bi bi-stopwatch"></i><span class="visually-hidden">Results</span></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>
